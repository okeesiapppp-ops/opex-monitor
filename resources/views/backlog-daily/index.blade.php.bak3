@push('scripts')
<script>
$(document).ready(function() {

    $('#select-all').on('change', function() {
        $('.row-checkbox').prop('checked', $(this).is(':checked'));
        updateBulkActions();
    });
    $(document).on('change', '.row-checkbox', function() { updateBulkActions(); });

    function updateBulkActions() {
        var count = $('.row-checkbox:checked').length;
        if (count > 0) { $('#bulk-actions').show(); $('#selected-count').text(count + ' data dipilih'); }
        else { $('#bulk-actions').hide(); }
    }

    $(document).on('click', '.btn-action', function() {
        var id = $(this).data('id'), status = $(this).data('status');
        var label = status == 'complete' ? 'Complete' : 'Outstanding';
        if (confirm('Tandai data ini sebagai ' + label + '?')) { updateStatus([id], status); }
    });

    $(document).on('click', '.btn-delete', function() {
        var id = $(this).data('id');
        if (confirm('Yakin hapus data ini?')) {
            $.ajax({
                url: '/backlog-daily/' + id,
                method: 'POST',
                data: { _method: 'DELETE', _token: '{{ csrf_token() }}' },
                success: function(response) {
                    if (response.success) { alert(response.message); $('#row-' + id).remove(); }
                },
                error: function() { alert('Gagal menghapus data!'); }
            });
        }
    });

    $('#btn-bulk-delete').on('click', function() {
        var ids = getSelectedIds();
        if (ids.length === 0) return;
        if (confirm('Yakin hapus ' + ids.length + ' data terpilih?')) {
            $.ajax({
                url: '{{ route("backlog-daily.bulk-delete") }}',
                method: 'POST',
                data: { _method: 'DELETE', _token: '{{ csrf_token() }}', ids: ids },
                success: function(response) {
                    if (response.success) { alert(response.message); location.reload(); }
                },
                error: function() { alert('Gagal menghapus data!'); }
            });
        }
    });

    $('#btn-complete').on('click', function() {
        var ids = getSelectedIds();
        if (ids.length === 0) return;
        if (confirm('Tandai ' + ids.length + ' data sebagai Complete?')) { updateStatus(ids, 'complete'); }
    });



    function getSelectedIds() {
        var ids = [];
        $('.row-checkbox:checked').each(function() { ids.push($(this).val()); });
        return ids;
    }

    function updateStatus(ids, status) {
        $.ajax({
            url: '{{ route("dashboard.update-status") }}',
            method: 'POST',
            data: { _token: '{{ csrf_token() }}', ids: ids, status: status },
            success: function(response) {
                if (response.success) { alert('Status berhasil diupdate!'); location.reload(); }
            },
            error: function() { alert('Gagal update status!'); }
        });
    }

});
var cancelId = null;
$(document).ready(function() {
    $(document).on("click", ".btn-cancel", function() { cancelId = $(this).data("id"); $("#cancelReason").val(""); $("#cancelModal").modal("show"); });
    $("#btnConfirmCancel").on("click", function() { var reason = $("#cancelReason").val(); if (!reason) { alert("Wajib isi alasan!"); return; } $.ajax({ url: "/cancel/" + cancelId + "/cancel", method: "POST", data: { _token: "{{ csrf_token() }}", cancel_reason: reason }, success: function(r) { if (r.success) { $("#cancelModal").modal("hide"); location.reload(); } }, error: function() { alert("Gagal!"); } }); });
});
</script>
<div class="modal fade" id="cancelModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-danger text-white"><h5 class="modal-title">Cancel Data</h5><button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body"><textarea id="cancelReason" class="form-control" rows="3" placeholder="Alasan cancel..."></textarea></div><div class="modal-footer"><button class="btn btn-secondary" data-dismiss="modal">Batal</button><button class="btn btn-danger" id="btnConfirmCancel">Konfirmasi Cancel</button></div></div></div></div>
@endpush