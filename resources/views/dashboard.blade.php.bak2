@push('scripts')
<script>
$(document).ready(function() {
    // ETA input handler
    $(document).on('change', '.eta-input', function() {
        var id = $(this).data('id');
        var eta = $(this).val();
        $.ajax({
            url: '/backlog-daily/' + id + '/update-eta',
            method: 'POST',
            data: { _token: '{{ csrf_token() }}', eta: eta },
            success: function(response) {
                if (response.success) { console.log('ETA updated'); }
            },
            error: function() { alert('Gagal update ETA!'); }
        });
    });

    // Posisi input handler
    $(document).on('change', '.posisi-input', function() {
        var id = $(this).data('id');
        var posisi = $(this).val();
        $.ajax({
            url: '/backlog-daily/' + id + '/update-posisi',
            method: 'POST',
            data: { _token: '{{ csrf_token() }}', posisi: posisi },
            success: function(response) {
                if (response.success) { console.log('Posisi updated'); }
            },
            error: function() { alert('Gagal update Posisi!'); }
        });
    });


    // SELECT ALL
    $('#select-all').on('change', function() {
        $('.row-checkbox').prop('checked', $(this).is(':checked'));
        updateBulkActions();
    });
    $(document).on('change', '.row-checkbox', function() { updateBulkActions(); });
    function updateBulkActions() {
        var count = $('.row-checkbox:checked').length;
        if (count > 0) { $('#bulk-actions').show(); $('#selected-count').text(count + ' data dipilih'); }
        else { $('#bulk-actions').hide(); }
    }

    // ACTION BUTTONS
    $(document).on('click', '.btn-action', function() {
        var id = $(this).data('id'), status = $(this).data('status');
        if (confirm('Tandai data ini sebagai ' + (status == 'complete' ? 'Complete' : 'Outstanding') + '?')) {
            updateStatus([id], status);
        }
    });
    $('#btn-complete').on('click', function() {
        var ids = getSelectedIds();
        if (ids.length === 0) return;
        if (confirm('Tandai ' + ids.length + ' data sebagai Complete?')) updateStatus(ids, 'complete');
    });

    function getSelectedIds() {
        var ids = [];
        $('.row-checkbox:checked').each(function() { ids.push($(this).val()); });
        return ids;
    }
    function updateStatus(ids, status) {
        $.ajax({
            url: '{{ route("dashboard.update-status") }}',
            method: 'POST',
            data: { _token: '{{ csrf_token() }}', ids: ids, status: status },
            success: function(r) { if (r.success) { alert('Status berhasil diupdate!'); location.reload(); } },
            error: function() { alert('Gagal update status!'); }
        });
    }

    // REMARKS
    $(document).on('mousedown', '.remarks-input[readonly]', function(e) {
        e.preventDefault();
        var $input = $(this);
        if (confirm('Apakah Anda yakin ingin mengubah remarks ini?')) {
            $input.prop('readonly', false).addClass('editable');
            setTimeout(function() {
                $input.focus();
                var len = $input.val().length;
                $input[0].setSelectionRange(len, len);
            }, 10);
        }
    });
    $(document).on('blur', '.remarks-input', function() {
        var $input = $(this);
        if (!$input.prop('readonly')) {
            $input.prop('readonly', true).removeClass('editable');
            $.ajax({
                url: '{{ route("dashboard.update-remarks") }}',
                method: 'POST',
                data: { _token: '{{ csrf_token() }}', id: $input.data('id'), remarks: $input.val() },
                error: function() { alert('Gagal menyimpan remarks!'); }
            });
        }
    });

    // PILIH TANGGAL DI MODAL HAPUS
    $(document).on('click', '.tanggal-item', function() {
        $('.tanggal-item').removeClass('selected');
        $(this).addClass('selected');
        var tgl = $(this).data('tanggal');
        var tglLabel = $(this).find('.tgl-date').text().trim();
        $('#hapus-tanggal-selected').val(tgl);
        $('#hapus-tgl-label').text(tglLabel);
        $('#hapus-info').show();
        $('#btn-hapus-data').prop('disabled', false);
    });

    $('#modalHapus').on('hidden.bs.modal', function() {
        $('.tanggal-item').removeClass('selected');
        $('#hapus-tanggal-selected').val('');
        $('#hapus-info').hide();
        $('#btn-hapus-data').prop('disabled', true);
    });

    // HAPUS DATA
    $('#btn-hapus-data').on('click', function() {
        var tanggal = $('#hapus-tanggal-selected').val();
        var label   = $('#hapus-tgl-label').text().trim();
        if (!tanggal) { alert('Pilih tanggal import yang ingin dihapus terlebih dahulu.'); return; }
        if (confirm('Yakin hapus data import tanggal ' + label + '?\n\nData yang sudah Complete tidak akan terhapus.')) {
            $.ajax({
                url: '{{ route("dashboard.hapus-data") }}',
                method: 'POST',
                data: { _method: 'DELETE', _token: '{{ csrf_token() }}', tanggal: tanggal },
                success: function(r) {
                    if (r.success) { alert(r.message); $('#modalHapus').modal('hide'); location.reload(); }
                },
                error: function() { alert('Gagal menghapus data!'); }
            });
        }
    });

    // CHART Doughnut
    const statusCtx = document.getElementById('backlogStatusChart');
    if (statusCtx) {
        const statusData = @json($backlogByStatus);
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: statusData.map(i => i.status ? i.status.toUpperCase() : 'UNKNOWN'),
                datasets: [{ data: statusData.map(i => i.total), backgroundColor: ['#28a745','#FFD700','#6c757d','#dc3545'], borderWidth: 3, borderColor: '#fff' }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 10 } } },
                cutout: '65%'
            }
        });
    }

    // CHART Line
    const trendCtx = document.getElementById('monthlyTrendChart');
    if (trendCtx) {
        const trendData = @json($monthlyTrend);
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: trendData.map(i => months[i.month - 1] + ' ' + i.year),
                datasets: [
                    { label: 'Total Backlog', data: trendData.map(i => i.total), borderColor: '#1A202C', backgroundColor: 'rgba(26,32,44,0.07)', tension: 0.4, fill: true, pointRadius: 4, pointBackgroundColor: '#1A202C' },
                    { label: 'Complete', data: trendData.map(i => i.completed), borderColor: '#FFD700', backgroundColor: 'rgba(255,215,0,0.1)', tension: 0.4, fill: true, pointRadius: 4, pointBackgroundColor: '#FFD700' }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { font: { size: 11 } } } },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } }, x: { grid: { display: false } } }
            }
        });
    }
});


</script>
@endpush